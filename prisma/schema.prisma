generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model JadwalIbadah {
  id            String   @id @default(cuid())
  namaIbadah    String
  hari          String
  waktu         String
  lokasi        String
  metode        String   @default("offline")
  linkStreaming  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("jadwal_ibadah")
}

model PelayananKategorial {
  id           String  @id @default(cuid())
  nama         String
  singkatan    String  @unique
  deskripsi    String
  jadwal       String
  kontakPerson String?
  iconUrl      String?
  order        Int     @default(0)

  @@map("pelayanan_kategorial")
}

model Unduhan {
  id        String   @id @default(cuid())
  judul     String
  tipe      String   // "TAIB" | "WARTA"
  tanggal   DateTime
  fileUrl   String
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unduhan")
}

model DokumentasiEvent {
  id         String              @id @default(cuid())
  namaAcara  String
  tanggal    DateTime
  coverPhoto String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  photos     DokumentasiPhoto[]

  @@map("dokumentasi_event")
}

model DokumentasiPhoto {
  id        String             @id @default(cuid())
  eventId   String
  event     DokumentasiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int                @default(0)
  createdAt DateTime           @default(now())

  @@map("dokumentasi_photo")
}
