generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  EDITOR
  MULTIMEDIA_ADMIN
  MULTIMEDIA_MEMBER
}

model User {
  id              String            @id  // matches Supabase auth.users.id
  email           String            @unique
  name            String?
  roles           UserRole[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  multimediaMember MultimediaMember?

  @@map("users")
}

model JadwalIbadah {
  id            String   @id @default(cuid())
  namaIbadah    String
  hari          String
  waktu         String
  lokasi        String
  metode        String   @default("offline")
  linkStreaming  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("jadwal_ibadah")
}

model PelayananKategorial {
  id           String  @id @default(cuid())
  nama         String
  singkatan    String  @unique
  deskripsi    String
  jadwal       String
  kontakPerson String?
  iconUrl      String?
  order        Int     @default(0)

  @@map("pelayanan_kategorial")
}

model Unduhan {
  id        String   @id @default(cuid())
  judul     String
  tipe      String   // "TAIB" | "WARTA"
  tanggal   DateTime
  fileUrl   String
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("unduhan")
}

model DokumentasiEvent {
  id         String              @id @default(cuid())
  namaAcara  String
  tanggal    DateTime
  coverPhoto String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  photos     DokumentasiPhoto[]

  @@map("dokumentasi_event")
}

model DokumentasiPhoto {
  id        String             @id @default(cuid())
  eventId   String
  event     DokumentasiEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int                @default(0)
  createdAt DateTime           @default(now())

  @@map("dokumentasi_photo")
}

// --- Multimedia Team Scheduler ---

enum ScheduleStatus {
  DRAFT
  COLLECTING
  GENERATING
  REVIEW
  PUBLISHED
}

enum MultimediaRole {
  SLD
  SND
  STR
  CAM
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
}

model MultimediaMember {
  id             String              @id @default(cuid())
  userId         String?             @unique
  user           User?               @relation(fields: [userId], references: [id])
  nama           String
  phone          String?
  roles          MultimediaRole[]
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  availability   MemberAvailability[]
  assignments    ScheduleAssignment[]

  @@map("multimedia_members")
}

model SchedulePeriod {
  id                   String            @id @default(cuid())
  nama                 String
  bulan                Int
  tahun                Int
  status               ScheduleStatus    @default(DRAFT)
  deadlineAvailability DateTime?
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  events               ScheduleEvent[]
  notes                String?

  @@unique([bulan, tahun])
  @@map("schedule_periods")
}

model ScheduleEvent {
  id             String              @id @default(cuid())
  periodId       String
  period         SchedulePeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  namaEvent      String
  tanggal        DateTime
  waktu          String
  kategori       String
  keterangan     String?
  isLive         Boolean             @default(false)
  requiredRoles  MultimediaRole[]
  assignments    ScheduleAssignment[]
  availability   MemberAvailability[]
  order          Int                 @default(0)

  @@map("schedule_events")
}

model MemberAvailability {
  id         String              @id @default(cuid())
  memberId   String
  member     MultimediaMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  eventId    String
  event      ScheduleEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status     AvailabilityStatus  @default(AVAILABLE)
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([memberId, eventId])
  @@map("member_availability")
}

model ScheduleAssignment {
  id         String              @id @default(cuid())
  eventId    String
  event      ScheduleEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId   String
  member     MultimediaMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       MultimediaRole
  isManual   Boolean             @default(false)
  createdAt  DateTime            @default(now())

  @@unique([eventId, memberId])
  @@map("schedule_assignments")
}
